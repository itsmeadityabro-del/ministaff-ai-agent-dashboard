# Get it from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=sk_live_replace_me

# Get it from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_replace_me

# Supabase project URL and browser-safe publishable key (Project Settings -> API Keys).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback only; prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY on new deployments.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase secret API key. It bypasses RLS: never prefix with NEXT_PUBLIC_,
# commit, expose to the browser, or paste into chat. Legacy fallback supported during migration.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production only (local dev uses the browser's origin). Set your deployed URL and re-run
# `npm run setup` so Supabase allow-lists it for auth email redirects.
# NEXT_PUBLIC_SITE_URL=https://your-app.com


# Required for the server-side lead queue worker. Use a long random secret in the host's secret
# manager. Keep automatic triage off until staging tests are complete.
MINISTAFF_CRON_SECRET=
MINISTAFF_AUTO_TRIAGE_ENABLED=false
